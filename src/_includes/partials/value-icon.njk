{#- Line icons for the values on the About page. Usage: {{ valueIcon("heart") }}
    Names: heart, star, shield, people, lightbulb, leaf. Decorative, so hidden from screen readers. -#}
{% macro valueIcon(name) -%}
<span class="value-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
{%- if name == "heart" %}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
{%- elif name == "star" %}<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
{%- elif name == "shield" %}<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/>
{%- elif name == "people" %}<circle cx="9" cy="8" r="3"/><path d="M3.5 19c.5-3.3 2.8-5 5.5-5s5 1.7 5.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.3c2.5-.3 4.6 1.2 5 4.2"/>
{%- elif name == "lightbulb" %}<path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.4 1.1 2.2h5c0-.8.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/>
{%- elif name == "leaf" %}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l8-8"/>
{%- endif %}</svg></span>
{%- endmacro %}
