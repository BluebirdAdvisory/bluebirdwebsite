---
layout: layouts/base.njk
crumb: { label: "What we do", url: "/what-we-do/" }
---
{% include "partials/page-hero.njk" %}
<section class="wrap section">
  <h2 class="section-title">{{ offerings_heading or "What this service includes" }}</h2>
  <ul class="offerings">
    {% for o in offerings %}<li>{{ o | mdInline | safe }}</li>{% endfor %}
  </ul>
</section>
{% if roles %}
<section class="band-mist">
  <div class="wrap section">
    <h2 class="section-title">Roles we recruit for</h2>
    {% if roles_intro %}<p class="section-intro">{{ roles_intro }}</p>{% endif %}
    <ul class="roles">
      {% for r in roles %}<li><h3>{{ r.title }}</h3><p>{{ r.text }}</p></li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% set related = collections.caseStudies | forService(title) %}
{% if related.length %}
<section class="band-mist">
  <div class="wrap section">
    <h2 class="section-title">Case studies</h2>
    {% set list = related %}{% include "partials/case-grid.njk" %}
  </div>
</section>
{% endif %}
{% if content | trim %}
<div class="wrap section"><div class="prose">{{ content | safe }}</div></div>
{% endif %}
{% include "partials/cta.njk" %}
